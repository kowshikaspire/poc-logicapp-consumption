{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "value": "PurchaseOrderProcessing"
    },
    "location": {
      "value": "eastus"
    },
    "sqlServerName": {
      "value": "poc-purchaseorder-sql"
    },
    "sqlDatabaseName": {
      "value": "PurchaseOrderDb"
    },
    "vendorsTableName": {
      "value": "dbo.Vendors"
    },
    "orderHeaderTableName": {
      "value": "dbo.OrderHeader"
    },
    "orderLineTableName": {
      "value": "dbo.OrderLine"
    },
    "errorLogTableName": {
      "value": "ErrorLog"
    },
    "serviceBusNamespace": {
      "value": "poc-purchaseorder-sb"
    },
    "fulfilmentQueueName": {
      "value": "orders-to-fulfil"
    },
    "supportTeamEmail": {
      "value": "support-team@contoso.com"
    },
    "procurementIpRanges": {
      "value": [
        "203.0.113.0/24"
      ]
    },
    "approvalThreshold": {
      "value": 10000
    },
    "approvalTimeout": {
      "value": "PT24H"
    },
    "office365ConnectionAuthorization": {
      "value": "PLACEHOLDER_NOT_A_REAL_TOKEN"
    }
  }
}
